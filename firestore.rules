rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Competitions — anyone can read, only authenticated admins can write
    match /competitions/{compId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Participants sub-collection — anyone can read, authenticated can write
      match /participants/{partId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Users — owner can read/write their own doc, admins can read all
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Students — anyone can read (for login check), only authenticated admins can write
    match /students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Playground settings — anyone can read, only authenticated admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Playground participants — anyone can read/write (students don't have Firebase auth)
    match /playground_participants/{partId} {
      allow read: if true;
      allow write: if true;
    }

    // Playground rankings (for Live Viewer) — anyone can read/write
    match /playground_rankings/{rankId} {
      allow read: if true;
      allow write: if true;
    }

    // Winners — anyone can read/write (admin writes from playground control)
    match /winners/{winnerId} {
      allow read: if true;
      allow write: if true;
    }

    // Batches — anyone can read, only authenticated admins can write
    match /batches/{batchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Enrollments — anyone can read and write (public enrollment form)
    match /enrollments/{enrollId} {
      allow read: if true;
      allow write: if true;
    }

    // Competition History — anyone can read/write (saved from playground)
    match /competition_history/{historyId} {
      allow read: if true;
      allow write: if true;
    }

    // Session logs — public write (students have no Firebase auth), admin read/update/delete
    match /session_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Institutes — anyone can read, only authenticated admins can write
    match /institutes/{instituteId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Institute settings (payment keys, etc.) — only authenticated admin
      match /settings/{settingId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // Payments sub-collection — only authenticated admin
      match /payments/{paymentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Student Sessions — for single-device login enforcement
    match /student_sessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    // Events — anyone can read, only authenticated admins can write
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event Enrollments — anyone can read/write (public enrollment)
    match /event_enrollments/{enrollId} {
      allow read: if true;
      allow write: if true;
    }

    // Super Admin data — only superadmin role via custom claims
    match /superadminData/{doc} {
      allow read, write: if request.auth != null && request.auth.token.role == "superadmin";
    }

    // Admin Activity Logs — superadmin read, Cloud Functions write
    match /adminLogs/{logId} {
      allow read: if request.auth != null && request.auth.token.role == "superadmin";
      allow write: if false; // Only Cloud Functions can write
    }

    // App Config — public read (except private config), superadmin write
    match /appConfig/{configId} {
      allow read: if configId != "payment_private";
      allow write: if request.auth != null && request.auth.token.role == "superadmin";
    }

    // App Config Private — superadmin read/write only
    match /appConfig/payment_private {
      allow read, write: if request.auth != null && request.auth.token.role == "superadmin";
    }

    // Root Payments collection — only authenticated admins
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }
  }
}
